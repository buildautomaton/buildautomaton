{
  "name": "@buildautomaton/plugins",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Plugin catalog: stores, sessions, harnesses, transport, tools, and buildautomaton. Use as starting points, or look them up in the marketplace.",
  "author": "BuildAutomaton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildautomaton/meta-harness.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/buildautomaton/meta-harness/tree/main/packages/plugins",
  "bugs": {
    "url": "https://github.com/buildautomaton/meta-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./ui": "./src/buildautomaton/ui.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:widget": "vite build --config vite.widget.config.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@buildautomaton/runtime": "workspace:*",
    "marked": "^18.0.14",
    "@agentclientprotocol/codex-acp": "^1.1.4",
    "@agentclientprotocol/sdk": "^0.14.0",
    "node-sqlite3-wasm": "^0.8.57",
    "tree-kill": "^1.2.2"
  },
  "peerDependencies": {
    "@buildautomaton/ui-runtime": "workspace:*",
    "lucide-react": "^0.344.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "peerDependenciesMeta": {
    "@buildautomaton/ui-runtime": { "optional": true },
    "lucide-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@buildautomaton/ui-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist", "src", "skills", "LICENSE", "README.md"]
}
