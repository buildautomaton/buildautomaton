{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@plugins/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/buildautomaton/plugins/ui",
    "src/buildautomaton/app",
    "src/buildautomaton/widget",
    "src/buildautomaton/ui.ts",
    "src/buildautomaton/ui-set.ts",
    "src/buildautomaton/ui-set.test.ts"
  ]
}
