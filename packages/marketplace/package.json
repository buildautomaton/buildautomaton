{
  "name": "@buildautomaton/marketplace",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Marketplace app: catalog plugins, Cloudflare store host, and UI for the runtime",
  "author": "BuildAutomaton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildautomaton/meta-harness.git",
    "directory": "packages/marketplace"
  },
  "homepage": "https://github.com/buildautomaton/meta-harness/tree/main/packages/marketplace",
  "bugs": {
    "url": "https://github.com/buildautomaton/meta-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./src/ui.ts",
    "./do": "./src/worker-do.ts",
    "./host": "./src/worker-handle.ts",
    "./paths": "./src/worker-paths.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@buildautomaton/plugins": "workspace:*",
    "@buildautomaton/runtime": "workspace:*"
  },
  "peerDependencies": {
    "@buildautomaton/product-director": "workspace:*",
    "@buildautomaton/ui-runtime": "workspace:*",
    "lucide-react": "^0.344.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "peerDependenciesMeta": {
    "@buildautomaton/product-director": { "optional": true },
    "@buildautomaton/ui-runtime": { "optional": true },
    "lucide-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@buildautomaton/product-director": "workspace:*",
    "@buildautomaton/ui-runtime": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "lucide-react": "^0.344.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist", "src"]
}
