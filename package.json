{
  "name": "meta-harness",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buildautomaton/meta-harness.git"
  },
  "workspaces": [
    "runtimes/*",
    "plugins",
    "apps/*"
  ],
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "pnpm --filter @buildautomaton/local-cli dev",
    "build": "turbo run build",
    "start": "pnpm --filter @buildautomaton/local-cli start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "publish:packages": "pnpm -r publish --filter=@buildautomaton/runtime --filter=@buildautomaton/plugins --filter=@buildautomaton/ui-runtime --filter=@buildautomaton/local-cli --access public"
  },
  "devDependencies": {
    "turbo": "^1.12.4"
  }
}
